# Manual isolated test only. Review baseline credentials separately; never reuse historical keys.
TICKET_SUPPORT_ACK=REPLACE_WITH_AUTHORIZATION_ACK
TICKET_BASELINE_REVIEW_ACK=REPLACE_WITH_BASELINE_REVIEW_ACK
GETCLIENTID_REVIEW_ACK=REPLACE_WITH_IDENTITY_REVIEW_ACK
PTERODACTYL_EXTERNAL_ID_ACK=REPLACE_WITH_MAPPING_ACK
TICKET_BOT_ROOT=REPLACE_WITH_ABSOLUTE_EXTRACTED_BASELINE_DIRECTORY
TEST_TICKET_GUILD_ID=REPLACE_WITH_TEST_GUILD_ID
# Empty disables shadow mode. Add the first 3–5 test ticket channel IDs, comma separated.
SHADOW_TICKET_CHANNEL_IDS=
TICKET_STAFF_USER_IDS=REPLACE_WITH_AUTHORIZED_STAFF_SNOWFLAKES_COMMA_SEPARATED
# Optional. Only use a separately reviewed private staff-only text channel.
TICKET_AUDIT_CHANNEL_ID=
TICKET_AUDIT_REVIEW_ACK=
TICKET_CONTEXT_KEY=REPLACE_WITH_RANDOM_CONTEXT_KEY_AT_LEAST_32_BYTES
SUPPORT_CORE_PORT=3001
# Optional. Empty uses this repository's knowledge/ folder. Only reviewed shared support docs.
# Use an absolute path for an external folder; quote paths containing spaces.
SUPPORT_KNOWLEDGE_ROOT=
WHMCS_BASE_URL=https://whmcs-test.example.invalid
WHMCS_API_IDENTIFIER=REPLACE_WITH_NEW_TEST_IDENTIFIER
WHMCS_API_SECRET=REPLACE_WITH_NEW_TEST_SECRET
PTERODACTYL_BASE_URL=https://panel-test.example.invalid
PTERODACTYL_APPLICATION_API_KEY=REPLACE_WITH_READ_ONLY_APPLICATION_KEY
PTERODACTYL_CLIENT_API_KEY=REPLACE_WITH_APPROVED_CLIENT_KEY
AGENT_LIVE_MODEL=1
MODEL_PROVIDER=sub2api
# Supply the matching chat model key securely in the shell environment.
