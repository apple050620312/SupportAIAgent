{
  "id": "hosting-support",
  "name": "Hosting Support",
  "version": "0.0.0",
  "description": "Bounded hosting support and low-risk recovery through trusted Support Core",
  "skills": ["./skills/hosting-support"],
  "activation": { "onStartup": true },
  "contracts": {
    "tools": ["search_support_knowledge", "read_support_article", "identify_customer", "list_my_services", "get_service_details", "list_my_servers", "get_my_server_status", "get_my_server_resources", "restart_my_server", "list_my_files", "read_my_file", "get_my_startup_config", "propose_mutation", "execute_approved_mutation", "handoff_to_staff"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["coreBaseUrl"],
    "properties": {
      "coreBaseUrl": { "type": "string", "description": "Protected Support Core installation root" },
      "agentId": { "type": "string", "default": "hosting-support", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
    }
  }
}
